
@page "/admin/hotels"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using HotelBookingSystem.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HotelDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Manage hotels</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0">Hotels</h1>
        <div>
            <a href="/admin" class="btn btn-outline-secondary me-2">
                ← Admin panel
            </a>
            <a href="/admin/hotels/new" class="btn btn-success">
                + Add hotel
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    @if (rows is null)
    {
        <p>Loading...</p>
    }
    else if (rows.Count == 0)
    {
        <div class="alert alert-info">
            No hotels yet. Add the first one.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px"></th>
                            <th>Name</th>
                            <th>City</th>
                            <th>Price / night</th>
                            <th>Rating</th>
                            <th>Bookings</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>
                                    <img src="@row.Image"
                                         alt="@row.Name"
                                         style="width:80px;height:55px;object-fit:cover;border-radius:6px" />
                                </td>
                                <td class="fw-semibold">@row.Name</td>
                                <td>@row.City</td>
                                <td>$@row.Price</td>
                                <td>⭐ @row.Rating</td>
                                <td>@row.BookingsCount</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="@($"/admin/hotels/{row.Id}/rooms")"
                                           class="btn btn-sm btn-outline-success">
                                            Rooms
                                        </a>

                                        <a href="@($"/admin/hotels/{row.Id}/edit")"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <button class="btn btn-sm btn-outline-danger"
                                                disabled="@(row.BookingsCount > 0)"
                                                title="@(row.BookingsCount > 0 ? "Hotels with bookings cannot be deleted" : "Delete hotel")"
                                                @onclick="() => DeleteAsync(row)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<HotelRow>? rows;
    private string? message;
    private string messageClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        rows = await db.Hotels
            .OrderBy(h => h.Name)
            .Select(h => new HotelRow(
                h.Id,
                h.Name,
                h.City,
                h.Price,
                h.Rating,
                h.Image,
                h.Bookings.Count))
            .ToListAsync();
    }

    private async Task DeleteAsync(HotelRow row)
    {
        if (row.BookingsCount > 0)
        {
            Show(
                $"Cannot delete \"{row.Name}\": it has {row.BookingsCount} booking(s).",
                isError: true);
            return;
        }

        if (!await JS.InvokeAsync<bool>(
            "confirm", $"Delete hotel \"{row.Name}\"?"))
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var hotel = await db.Hotels.FindAsync(row.Id);

            if (hotel is not null)
            {
                db.Hotels.Remove(hotel);
                await db.SaveChangesAsync();
            }

            Show($"Hotel \"{row.Name}\" deleted.", isError: false);
        }
        catch (DbUpdateException)
        {
            Show(
                "Cannot delete this hotel because it has related records.",
                isError: true);
        }

        await LoadAsync();
    }

    private void Show(string text, bool isError)
    {
        message = text;
        messageClass = isError ? "alert-danger" : "alert-success";
    }

    private record HotelRow(
        int Id,
        string Name,
        string City,
        decimal Price,
        double Rating,
        string Image,
        int BookingsCount);
}
