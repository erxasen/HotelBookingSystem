@using HotelBookingSystem.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HotelDbContext> DbFactory
@page "/booking"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<PageTitle>Book a Hotel</PageTitle>

<div class="container py-5">
    <h1 class="fw-bold mb-3">Hotel Reservation</h1>
    <p class="text-muted">Complete your booking details below.</p>

    @if (!bookingConfirmed)
    {
        <div class="card shadow-sm p-4">
            <h3 class="mb-4">Booking Details</h3>

            <EditForm Model="@booking" OnValidSubmit="ConfirmBooking"
                      FormName="hotelBooking">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Select Hotel</label>
                    <InputSelect class="form-select"
                                 @bind-Value="booking.HotelName">
                        <option value="">Choose a hotel</option>
                        @foreach (var hotel in hotels)
                        {
                            <option value="@hotel.Name">
                                @hotel.Name - $@hotel.Price/night
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <InputText class="form-control"
                               @bind-Value="booking.FullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText class="form-control"
                               @bind-Value="booking.Email" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-in Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="booking.CheckIn" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-out Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="booking.CheckOut" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Number of Guests</label>
                    <InputNumber class="form-control"
                                 @bind-Value="booking.Guests" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <div class="alert alert-info">
                    <strong>Total Price:</strong> $@TotalPrice
                </div>

                <button type="submit" class="btn btn-success w-100">
                    Confirm Booking
                </button>
            </EditForm>
        </div>
    }
    else
    {
        <div class="alert alert-success p-4">
            <h2>Booking Confirmed!</h2>
            <p><strong>Hotel:</strong> @booking.HotelName</p>
            <p><strong>Guest:</strong> @booking.FullName</p>
            <p><strong>Email:</strong> @booking.Email</p>
            <p><strong>Check-in:</strong> @booking.CheckIn.ToShortDateString()</p>
            <p><strong>Check-out:</strong> @booking.CheckOut.ToShortDateString()</p>
            <p><strong>Guests:</strong> @booking.Guests</p>
            <h4>Total: $@TotalPrice</h4>

            <button class="btn btn-primary mt-3"
                    @onclick="NewBooking">
                Make Another Booking
            </button>
        </div>
    }
</div>

@code {
    private BookingModel booking = new();
    private bool bookingConfirmed = false;
    private string errorMessage = "";

 private List<HotelInfo> hotels = new();

protected override async Task OnInitializedAsync()
{
    await using var db = await DbFactory.CreateDbContextAsync();
    hotels = await db.Hotels
        .OrderBy(h => h.Name)
        .Select(h => new HotelInfo(h.Name, h.Price))
        .ToListAsync();
}

    private decimal TotalPrice
    {
        get
        {
            var hotel = hotels.FirstOrDefault(h =>
                h.Name == booking.HotelName);

            if (hotel == null) return 0;

            int nights = Math.Max(0,
                (booking.CheckOut - booking.CheckIn).Days);

            return hotel.Price * nights;
        }
    }

    
    private async Task ConfirmBooking()
{
    errorMessage = "";

    if (booking.CheckIn.Date < DateTime.Today)
    {
        errorMessage = "Check-in date cannot be in the past.";
        return;
    }

    if (booking.CheckOut <= booking.CheckIn)
    {
        errorMessage = "Check-out must be after check-in.";
        return;
    }

    try
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var hotel = await db.Hotels
            .FirstOrDefaultAsync(h => h.Name == booking.HotelName);

        if (hotel == null)
        {
            errorMessage = "Hotel not found.";
            return;
        }

        var checkIn = booking.CheckIn.Date;
        var checkOut = booking.CheckOut.Date;

        bool isTaken = await db.Bookings.AnyAsync(b =>
            b.HotelId == hotel.Id &&
            b.CheckIn < checkOut &&
            checkIn < b.CheckOut);

        if (isTaken)
        {
            errorMessage = "These dates are already booked for this hotel. Please choose other dates.";
            return;
        }

        var newBooking = new HotelBookingSystem.Models.Booking
        {
            HotelId = hotel.Id,
            FullName = booking.FullName,
            Email = booking.Email,
            CheckIn = checkIn,
            CheckOut = checkOut,
            Guests = booking.Guests,
            TotalPrice = hotel.Price * (checkOut - checkIn).Days
        };

        db.Bookings.Add(newBooking);
        await db.SaveChangesAsync();

        bookingConfirmed = true;
    }
    catch
    {
        errorMessage = "Could not save booking. Please try again.";
    }
}

    private void NewBooking()
    {
        booking = new BookingModel();
        bookingConfirmed = false;
        errorMessage = "";
    }

    private record HotelInfo(string Name, decimal Price);

    private class BookingModel
    {
        [Required(ErrorMessage = "Please select a hotel.")]
        public string HotelName { get; set; } = "";

        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = "";

        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public DateTime CheckIn { get; set; } = DateTime.Today.AddDays(1);

        [Required]
        public DateTime CheckOut { get; set; } = DateTime.Today.AddDays(2);

        [Range(1, 10, ErrorMessage = "Guests must be between 1 and 10.")]
        public int Guests { get; set; } = 1;
    }
}
