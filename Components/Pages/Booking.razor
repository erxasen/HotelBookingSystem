
@page "/booking"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using HotelBookingSystem.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HotelDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Book a Hotel</PageTitle>

<div class="container py-5">
    <h1 class="fw-bold mb-3">Hotel Reservation</h1>
    <p class="text-muted">
        Select a hotel, dates and an available room.
    </p>

    @if (bookingConfirmed)
    {
        <div class="alert alert-success p-4">
            <h2>Booking Confirmed!</h2>
            <p><strong>Hotel:</strong> @confirmedHotel</p>
            <p><strong>Room:</strong> @confirmedRoom</p>
            <p><strong>Guest:</strong> @booking.FullName</p>
            <p><strong>Email:</strong> @booking.Email</p>
            <p><strong>Check-in:</strong> @booking.CheckIn.ToShortDateString()</p>
            <p><strong>Check-out:</strong> @booking.CheckOut.ToShortDateString()</p>
            <p><strong>Guests:</strong> @booking.Guests</p>
            <h4>Total: $@confirmedTotal</h4>

            <button class="btn btn-primary mt-3"
                    @onclick="NewBooking">
                Make Another Booking
            </button>
        </div>
    }
    else
    {
        <div class="card shadow-sm p-4">
            <h3 class="mb-4">Booking Details</h3>

            <EditForm Model="@booking"
                      OnValidSubmit="ConfirmBooking"
                      FormName="hotelBooking">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Select Hotel</label>
                    <InputSelect class="form-select"
                                 @bind-Value="booking.HotelId"
                                 @bind-Value:after="ResetRooms">
                        <option value="0">Choose a hotel</option>
                        @foreach (var hotel in hotels)
                        {
                            <option value="@hotel.Id">
                                @hotel.Name
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <InputText class="form-control"
                               @bind-Value="booking.FullName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText class="form-control"
                               @bind-Value="booking.Email" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-in Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="booking.CheckIn"
                                   @bind-Value:after="ResetRooms" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-out Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="booking.CheckOut"
                                   @bind-Value:after="ResetRooms" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Number of Guests</label>
                    <InputNumber class="form-control"
                                 @bind-Value="booking.Guests"
                                 @bind-Value:after="ResetRooms" />
                </div>

                <button type="button"
                        class="btn btn-outline-primary w-100 mb-3"
                        disabled="@loadingRooms"
                        @onclick="FindAvailableRooms">
                    @(loadingRooms ? "Searching..." : "Find Available Rooms")
                </button>

                @if (roomsSearched)
                {
                    @if (availableRooms.Count == 0)
                    {
                        <div class="alert alert-warning">
                            No available rooms found for the selected dates and guests.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Available Rooms</label>

                            <InputSelect class="form-select"
                                         @bind-Value="booking.RoomId">
                                <option value="0">Choose a room</option>

                                @foreach (var room in availableRooms)
                                {
                                    <option value="@room.Id">
                                        Room @room.Number -
                                        @room.Type -
                                        Capacity: @room.Capacity -
                                        $@room.PricePerNight/night
                                    </option>
                                }
                            </InputSelect>
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <div class="alert alert-info">
                    <strong>Total Price:</strong> $@TotalPrice
                </div>

                <button type="submit"
                        class="btn btn-success w-100"
                        disabled="@saving">
                    @(saving ? "Saving..." : "Confirm Booking")
                </button>
            </EditForm>
        </div>
    }
</div>

@code {
    private BookingModel booking = new();
    private List<HotelInfo> hotels = new();
    private List<RoomInfo> availableRooms = new();

    private bool bookingConfirmed;
    private bool roomsSearched;
    private bool loadingRooms;
    private bool saving;

    private string errorMessage = "";
    private string confirmedHotel = "";
    private string confirmedRoom = "";
    private decimal confirmedTotal;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        hotels = await db.Hotels
            .AsNoTracking()
            .OrderBy(h => h.Name)
            .Select(h => new HotelInfo(h.Id, h.Name))
            .ToListAsync();
    }

    private decimal TotalPrice
    {
        get
        {
            var room = availableRooms
                .FirstOrDefault(r => r.Id == booking.RoomId);

            if (room is null)
                return 0;

            var nights = Math.Max(
                0,
                (booking.CheckOut.Date - booking.CheckIn.Date).Days);

            return room.PricePerNight * nights;
        }
    }

    private void ResetRooms()
    {
        availableRooms.Clear();
        booking.RoomId = 0;
        roomsSearched = false;
        errorMessage = "";
    }

    private bool ValidateDates()
    {
        if (booking.HotelId <= 0)
        {
            errorMessage = "Please select a hotel.";
            return false;
        }

        if (booking.CheckIn.Date < DateTime.Today)
        {
            errorMessage = "Check-in date cannot be in the past.";
            return false;
        }

        if (booking.CheckOut.Date <= booking.CheckIn.Date)
        {
            errorMessage = "Check-out must be after check-in.";
            return false;
        }

        if (booking.Guests < 1 || booking.Guests > 10)
        {
            errorMessage = "Guests must be between 1 and 10.";
            return false;
        }

        return true;
    }

    private async Task FindAvailableRooms()
    {
        errorMessage = "";
        availableRooms.Clear();
        booking.RoomId = 0;
        roomsSearched = false;

        if (!ValidateDates())
            return;

        loadingRooms = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var checkIn = booking.CheckIn.Date;
            var checkOut = booking.CheckOut.Date;

            availableRooms = await db.Rooms
                .AsNoTracking()
                .Where(r =>
                    r.HotelId == booking.HotelId &&
                    r.IsActive &&
                    r.Capacity >= booking.Guests &&
                    !db.Bookings.Any(b =>
                        b.RoomId == r.Id &&
                        b.CheckIn < checkOut &&
                        checkIn < b.CheckOut))
                .OrderBy(r => r.Number)
                .Select(r => new RoomInfo(
                    r.Id,
                    r.Number,
                    r.Type,
                    r.Capacity,
                    r.PricePerNight))
                .ToListAsync();

            roomsSearched = true;
        }
        
        catch (Exception ex)
        {
            errorMessage = $"Could not load available rooms: {ex.Message}";
            Console.WriteLine(ex.ToString());
        }

        finally
        {
            loadingRooms = false;
        }
    }

    private async Task ConfirmBooking()
    {
        errorMessage = "";

        if (saving)
            return;

        if (!ValidateDates())
            return;

        if (!roomsSearched || booking.RoomId <= 0)
        {
            errorMessage = "Please find and select an available room.";
            return;
        }

        var selectedRoom = availableRooms
            .FirstOrDefault(r => r.Id == booking.RoomId);

        if (selectedRoom is null)
        {
            errorMessage = "Please select a valid room.";
            return;
        }

        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();

        var userId = authState.User
            .FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "Please log in to make a booking.";
            return;
        }

        saving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var checkIn = booking.CheckIn.Date;
            var checkOut = booking.CheckOut.Date;

            await using var transaction =
                await db.Database.BeginTransactionAsync(
                    System.Data.IsolationLevel.Serializable);

            var room = await db.Rooms
                .FirstOrDefaultAsync(r =>
                    r.Id == booking.RoomId &&
                    r.HotelId == booking.HotelId &&
                    r.IsActive &&
                    r.Capacity >= booking.Guests);

            if (room is null)
            {
                errorMessage = "This room is no longer available.";
                return;
            }

            var isTaken = await db.Bookings.AnyAsync(b =>
                b.RoomId == room.Id &&
                b.CheckIn < checkOut &&
                checkIn < b.CheckOut);

            if (isTaken)
            {
                errorMessage = "This room is already booked for these dates.";
                return;
            }

            var hotel = await db.Hotels
                .FirstOrDefaultAsync(h => h.Id == booking.HotelId);

            if (hotel is null)
            {
                errorMessage = "Hotel not found.";
                return;
            }

            var total = room.PricePerNight *
                (checkOut - checkIn).Days;

            var newBooking = new HotelBookingSystem.Models.Booking
            {
                HotelId = hotel.Id,
                RoomId = room.Id,
                UserId = userId,
                FullName = booking.FullName.Trim(),
                Email = booking.Email.Trim(),
                CheckIn = checkIn,
                CheckOut = checkOut,
                Guests = booking.Guests,
                TotalPrice = total,
                CreatedAt = DateTime.UtcNow
            };

            db.Bookings.Add(newBooking);
            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            confirmedHotel = hotel.Name;
            confirmedRoom = room.Number;
            confirmedTotal = total;
            bookingConfirmed = true;
        }
        catch (Exception)
        {
            errorMessage = "Could not save booking. Please try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void NewBooking()
    {
        booking = new BookingModel();
        availableRooms.Clear();
        bookingConfirmed = false;
        roomsSearched = false;
        errorMessage = "";
        confirmedTotal = 0;
    }

    private record HotelInfo(int Id, string Name);

    private record RoomInfo(
        int Id,
        string Number,
        string Type,
        int Capacity,
        decimal PricePerNight);

    private class BookingModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Please select a hotel.")]
        public int HotelId { get; set; }

        public int RoomId { get; set; }

        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = "";

        public DateTime CheckIn { get; set; } =
            DateTime.Today.AddDays(1);

        public DateTime CheckOut { get; set; } =
            DateTime.Today.AddDays(2);

        [Range(1, 10, ErrorMessage = "Guests must be between 1 and 10.")]
        public int Guests { get; set; } = 1;
    }
}
