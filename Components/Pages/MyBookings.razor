
@page "/my-bookings"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using HotelBookingSystem.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HotelDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>My Bookings</PageTitle>

<div class="container py-5">
    <h1 class="fw-bold mb-3">My Bookings</h1>
    <p class="text-muted">Manage your hotel reservations.</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (loading)
    {
        <p>Loading bookings...</p>
    }
    else if (bookings.Count == 0)
    {
        <div class="alert alert-info">
            You have no bookings yet.
        </div>

        <a href="/booking" class="btn btn-primary">
            Make a Booking
        </a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Hotel</th>
                        <th>Room</th>
                        <th>Guest</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Guests</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in bookings)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Hotel.Name</td>
                            <td>@(item.Room?.Number ?? "N/A")</td>
                            <td>@item.FullName</td>
                            <td>@item.CheckIn.ToShortDateString()</td>
                            <td>@item.CheckOut.ToShortDateString()</td>
                            <td>@item.Guests</td>
                            <td>$@item.TotalPrice</td>
                            <td>
                                <button class="btn btn-danger btn-sm"
                                        disabled="@deleting"
                                        @onclick="() => CancelBooking(item.Id)">
                                    Cancel
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<HotelBookingSystem.Models.Booking> bookings = new();

    private bool loading = true;
    private bool deleting = false;

    private string errorMessage = "";
    private string successMessage = "";

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated != true)
            return null;

        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        loading = true;

        try
        {
            var userId = await GetCurrentUserId();

            if (string.IsNullOrEmpty(userId))
            {
                bookings.Clear();
                errorMessage = "Please log in to view your bookings.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            bookings = await db.Bookings
                .AsNoTracking()
                .Include(b => b.Hotel)
                .Include(b => b.Room)
                .Where(b => b.UserId == userId)
                .OrderByDescending(b => b.Id)
                .ToListAsync();

            errorMessage = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Could not load bookings.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CancelBooking(int id)
    {
        if (deleting)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to cancel this booking?"
        );

        if (!confirmed)
            return;

        deleting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var userId = await GetCurrentUserId();

            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "Please log in.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var booking = await db.Bookings
                .FirstOrDefaultAsync(b =>
                    b.Id == id &&
                    b.UserId == userId);

            if (booking is null)
            {
                errorMessage = "Booking not found or access denied.";
                return;
            }

            db.Bookings.Remove(booking);
            await db.SaveChangesAsync();

            await LoadBookings();

            successMessage = "Booking cancelled successfully.";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Could not cancel booking.";
        }
        finally
        {
            deleting = false;
        }
    }
}
